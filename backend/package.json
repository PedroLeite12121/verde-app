{
  "name": "+verde-backend",
  "version": "1.0.0",
  "description": "Backend API do app +Verde - Mapeamento de áreas não verdes e conexão com ONGs de reflorestamento",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "migrate:undo:last": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend",
    "docker:db": "docker compose exec db mysql -uroot -proot dbDadosVerde",
    "docker:migrate": "docker compose exec backend npm run migrate",
    "docker:seed": "docker compose exec backend npm run seed",
    "docker:setup": "docker compose up -d db && node -e \"setTimeout(() => process.exit(0), 5000)\" && npm run docker:migrate && npm run docker:seed",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch --runInBand --forceExit",
    "test:setup": "node scripts/setupTestDb.js",
    "test:all": "npm run test:setup && npm test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.7.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
